# 博客后端环境配置
# 复制此文件为 .env 并修改以下配置

# 管理员账号（请务必修改！）
ADMIN_USERNAME=admin

# 管理员密码哈希（使用 bcryptjs 生成，命令: node -e "const bcrypt = require('bcryptjs'); bcrypt.hash('your_password', 10).then(h => console.log(h))"）
ADMIN_PASSWORD_HASH=

# JWT 密钥（必填！服务启动前必须设置，长度不少于 16 位；可用命令生成: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"）
JWT_SECRET=

# 服务端口
PORT=3000

# 说明：上传大小限制不在此处配置，实际限制写在 server/routes/upload.js 中
# （图片/视频 10MB、音频 50MB、评论配图 10MB）

# 允许的跨域来源（生产环境请设置为具体域名，如: https://your-domain.com）
# ALLOWED_ORIGINS=https://your-domain.com
